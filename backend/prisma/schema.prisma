generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  RECRUITER
  CANDIDATE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String @id @default(cuid())

  email     String @unique
  password  String

  name      String?
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  designation String?
  experience  Int?
  isActive  Boolean @default(true)
  role      Role
  status    AccountStatus @default(ACTIVE)

  isVerified Boolean @default(false)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  deletedAt  DateTime?

  // Auth additions
  mustChangePassword           Boolean   @default(false)
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  passwordResetToken           String?
  passwordResetExpiresAt       DateTime?
  emailVerificationToken       String?
  emailVerificationExpiresAt   DateTime?

  sessions                     Session[]
  jobsCreated                  Job[]          @relation("JobCreator")
  jobsRecruited                JobRecruiter[] @relation("JobRecruiterUser")
  assignmentsMade              JobRecruiter[] @relation("JobRecruiterAssignedBy")


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  website      String?
  industry     String?
  companySize  String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  headquarters String?
  
  isVerified   Boolean       @default(false)
  status       AccountStatus @default(ACTIVE)

  deletedAt    DateTime?

  users        User[]
  departments  Department[]
  jobs         Job[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  company      Company   @relation(fields: [companyId], references: [id])
  recruiters   User[]
  jobs         Job[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum Visibility {
  INTERNAL
  PUBLIC
  PRIVATE
}

model Job {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobCode         String         @unique
  title           String
  description     String
  responsibilities String?
  requirements    String?
  benefits        String?
  employmentType  EmploymentType
  workplaceType   WorkplaceType
  experienceMin   Int?
  experienceMax   Int?
  salaryMin       Float?
  salaryMax       Float?
  currency        String?
  location        String?
  openings        Int
  visibility      Visibility     @default(PUBLIC)
  status          JobStatus      @default(DRAFT)
  closingDate     DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  isActive        Boolean        @default(true)
  createdBy       String
  creator         User           @relation("JobCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  recruiters      JobRecruiter[]
  skills          JobSkill[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([jobCode])
  @@index([createdBy])
  @@index([deletedAt])
}

model JobRecruiter {
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId  String
  recruiter    User     @relation("JobRecruiterUser", fields: [recruiterId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("JobRecruiterAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())

  @@id([jobId, recruiterId])
  @@index([recruiterId])
  @@index([jobId])
}

model Skill {
  id        String     @id @default(cuid())
  name      String     @unique
  jobs      JobSkill[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model JobSkill {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}