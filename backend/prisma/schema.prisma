generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  RECRUITER
  CANDIDATE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String @id @default(cuid())

  email     String @unique
  password  String

  name      String?
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  designation String?
  experience  Int?
  isActive  Boolean @default(true)
  role      Role
  status    AccountStatus @default(ACTIVE)

  isVerified Boolean @default(false)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  deletedAt  DateTime?

  // Auth additions
  mustChangePassword           Boolean   @default(false)
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  passwordResetToken           String?
  passwordResetExpiresAt       DateTime?
  emailVerificationToken       String?
  emailVerificationExpiresAt   DateTime?

  sessions                     Session[]
  jobsCreated                  Job[]          @relation("JobCreator")
  jobsRecruited                JobRecruiter[] @relation("JobRecruiterUser")
  assignmentsMade              JobRecruiter[] @relation("JobRecruiterAssignedBy")
  candidatesAssigned           Candidate[]    @relation("PrimaryRecruiter")
  candidatesCreated            Candidate[]    @relation("CandidateCreator")
  candidatesUpdated            Candidate[]    @relation("CandidateUpdater")
  candidateNotes               CandidateNote[]
  uploadedDocuments            CandidateDocument[]
  applicationsAssigned         Application[]  @relation("ApplicationAssignedRecruiter")
  applicationsCreated          Application[]  @relation("ApplicationCreator")
  applicationsUpdated          Application[]  @relation("ApplicationUpdater")
  interviewsInterviewer        InterviewInterviewer[] @relation("InterviewInterviewerUser")
  interviewsCreated            Interview[]            @relation("InterviewCreator")
  interviewsUpdated            Interview[]            @relation("InterviewUpdater")
  interviewsCancelled          Interview[]            @relation("InterviewCanceller")
  offersCreated                Offer[]                @relation("OfferCreator")
  offersApproved               Offer[]                @relation("OfferApprover")
  pipelinesAssigned            HiringPipeline[]       @relation("PipelineRecruiter")
  pipelinesHistoryMoved        PipelineHistory[]      @relation("PipelineHistoryMovedBy")
  pipelinesTimelineCreated     PipelineTimeline[]     @relation("PipelineTimelineCreatedBy")


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  website      String?
  industry     String?
  companySize  String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  headquarters String?
  
  isVerified   Boolean       @default(false)
  status       AccountStatus @default(ACTIVE)

  deletedAt    DateTime?

  users        User[]
  departments  Department[]
  jobs         Job[]
  candidates       Candidate[]
  tags             Tag[]
  candidateCounter CompanyCandidateCounter?
  applications     Application[]
  applicationCounter CompanyApplicationCounter?
  interviews       Interview[]
  interviewCounter CompanyInterviewCounter?
  offers           Offer[]
  offerCounter     CompanyOfferCounter?
  pipelines        HiringPipeline[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  company      Company   @relation(fields: [companyId], references: [id])
  recruiters   User[]
  jobs         Job[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum Visibility {
  INTERNAL
  PUBLIC
  PRIVATE
}

model Job {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobCode         String         @unique
  title           String
  description     String
  responsibilities String?
  requirements    String?
  benefits        String?
  employmentType  EmploymentType
  workplaceType   WorkplaceType
  experienceMin   Int?
  experienceMax   Int?
  salaryMin       Float?
  salaryMax       Float?
  currency        String?
  location        String?
  openings        Int
  visibility      Visibility     @default(PUBLIC)
  status          JobStatus      @default(DRAFT)
  closingDate     DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  isActive        Boolean        @default(true)
  createdBy       String
  creator         User           @relation("JobCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  recruiters      JobRecruiter[]
  skills          JobSkill[]
  applications    Application[]
  pipelines       HiringPipeline[]
  atsScores       ATSScore[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([jobCode])
  @@index([createdBy])
  @@index([deletedAt])
}

model JobRecruiter {
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId  String
  recruiter    User     @relation("JobRecruiterUser", fields: [recruiterId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("JobRecruiterAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())

  @@id([jobId, recruiterId])
  @@index([recruiterId])
  @@index([jobId])
}

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  jobs       JobSkill[]
  candidates CandidateSkill[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model JobSkill {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

enum CandidateStatus {
  ACTIVE
  PASSIVE
  ON_HOLD
  BLACKLISTED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  STUDENT
  FREELANCER
  SELF_EMPLOYED
  CONTRACT
}

enum CandidateSource {
  REFERRAL
  LINKEDIN
  NAUKRI
  INDEED
  CAREER_PAGE
  CONSULTANCY
  CAMPUS
  WALK_IN
  IMPORT
  OTHER
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum DocumentType {
  RESUME
  COVER_LETTER
  CERTIFICATE
  PORTFOLIO
  OTHER
}

model Candidate {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryRecruiterId String
  primaryRecruiter   User                 @relation("PrimaryRecruiter", fields: [primaryRecruiterId], references: [id], onDelete: Cascade)
  candidateCode      String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  alternatePhone     String?
  gender             Gender?
  address            String?
  city               String?
  state              String?
  country            String?
  zipCode            String?
  currentCompany     String?
  currentDesignation String?
  experienceYears    Int?
  experienceMonths   Int?
  expectedSalary     Float?
  currentSalary      Float?
  currency           String?
  noticePeriod       Int?
  employmentStatus   EmploymentStatus?
  source             CandidateSource?
  linkedInUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  status             CandidateStatus      @default(ACTIVE)
  isActive           Boolean              @default(true)
  deletedAt          DateTime?
  createdBy          String
  creator            User                 @relation("CandidateCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedBy          String?
  updater            User?                @relation("CandidateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  skills             CandidateSkill[]
  education          CandidateEducation[]
  experience         CandidateExperience[]
  documents          CandidateDocument[]
  notes              CandidateNote[]
  tags               CandidateTag[]
  applications       Application[]
  offers             Offer[]
  pipelines          HiringPipeline[]
  atsScores          ATSScore[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([companyId, candidateCode])
  @@index([companyId])
  @@index([primaryRecruiterId])
  @@index([status])
  @@index([deletedAt])
  @@index([email])
  @@index([phone])
}

model CandidateSkill {
  candidateId      String
  candidate        Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency      SkillProficiency @default(INTERMEDIATE)
  experienceYears  Int?
  experienceMonths Int?
  isPrimary        Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@id([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
}

model CandidateEducation {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  degree        String
  specialization String?
  institution   String
  university    String?
  startDate     DateTime?
  endDate       DateTime?
  graduationYear Int?
  grade         String?
  isHighest     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateExperience {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company        String
  designation    String
  employmentType String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateDocument {
  id           String       @id @default(cuid())
  candidateId  String
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileKey      String
  fileSize     Int?
  mimeType     String?
  documentType DocumentType @default(RESUME)
  isActive     Boolean      @default(true)
  uploadedBy   String
  uploader     User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([candidateId])
}

model CandidateNote {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
  @@index([authorId])
}

model Tag {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  candidates CandidateTag[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model CandidateTag {
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([candidateId, tagId])
  @@index([candidateId])
  @@index([tagId])
}

model CompanyCandidateCounter {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count     Int     @default(0)
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

model Application {
  id                   String            @id @default(cuid())
  applicationCode      String
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId          String
  candidate            Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                String
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedRecruiterId  String
  assignedRecruiter    User              @relation("ApplicationAssignedRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: Cascade)
  stage                ApplicationStage  @default(APPLIED)
  status               ApplicationStatus @default(ACTIVE)
  source               CandidateSource?
  remarks              String?           @db.VarChar(3000)
  rejectionReasonCode  String?
  rejectionReasonNote  String?           @db.VarChar(1000)
  withdrawalReasonCode String?
  withdrawalReasonNote String?           @db.VarChar(1000)
  appliedAt            DateTime          @default(now())
  createdBy            String
  creator              User              @relation("ApplicationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedBy            String?
  updater              User?             @relation("ApplicationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  interviews           Interview[]
  offers               Offer[]
  pipeline             HiringPipeline?

  @@unique([companyId, applicationCode])
  @@index([companyId])
  @@index([candidateId])
  @@index([jobId])
  @@index([assignedRecruiterId])
  @@index([stage])
  @@index([status])
  @@index([deletedAt])
}

model CompanyApplicationCounter {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count     Int     @default(0)
}

enum InterviewType {
  INTERNAL
  CLIENT
  CAMPUS
  WALK_IN
  OTHER
}

enum InterviewRound {
  SCREENING
  TECHNICAL
  MANAGERIAL
  HR
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewOutcome {
  PASS
  FAIL
  ON_HOLD
  RECOMMENDED
  STRONG_RECOMMEND
  NOT_RECOMMENDED
}

enum InterviewMode {
  ONLINE
  ONSITE
  PHONE
}

model Interview {
  id                 String             @id @default(cuid())
  interviewCode      String
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicationId      String
  application        Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewType      InterviewType
  round              InterviewRound
  status             InterviewStatus    @default(SCHEDULED)
  outcome            InterviewOutcome?
  mode               InterviewMode
  scheduledDate      DateTime
  startTime          DateTime
  endTime            DateTime
  timeZone           String
  meetingLink        String?            @db.VarChar(2048)
  location           String?            @db.VarChar(500)
  notes              String?            @db.VarChar(3000)
  resultNotes        String?            @db.VarChar(3000)
  cancellationReason String?            @db.VarChar(1000)
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?              @relation("InterviewCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  completedAt        DateTime?
  createdBy          String
  creator            User               @relation("InterviewCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedBy          String?
  updater            User?              @relation("InterviewUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  interviewers       InterviewInterviewer[]

  @@unique([companyId, interviewCode])
  @@index([companyId])
  @@index([applicationId])
  @@index([status])
  @@index([round])
  @@index([interviewType])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([deletedAt])
}

model InterviewInterviewer {
  id            String    @id @default(cuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   User      @relation("InterviewInterviewerUser", fields: [interviewerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([interviewerId])
}

model CompanyInterviewCounter {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count     Int     @default(0)
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum Currency {
  INR
  USD
  EUR
  GBP
  AED
  SGD
}

model Offer {
  id                  String               @id @default(uuid())
  offerCode           String
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicationId       String
  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId         String
  recruiter           User                 @relation("OfferCreator", fields: [recruiterId], references: [id], onDelete: Cascade)
  version             Int                  @default(1)
  status              OfferStatus          @default(DRAFT)
  salary              Decimal              @db.Decimal(12, 2)
  currency            Currency
  employmentType      EmploymentType
  joiningDate         DateTime
  expiryDate          DateTime
  benefits            String?              @db.VarChar(5000)
  notes               String?              @db.VarChar(3000)
  offerLetterUrl      String?              @db.VarChar(2048)
  offerLetterFileName String?              @db.VarChar(500)
  approvedBy          String?
  approver            User?                @relation("OfferApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  sentAt              DateTime?
  viewedAt            DateTime?
  respondedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  @@unique([companyId, offerCode, version])
  @@index([companyId])
  @@index([applicationId])
  @@index([candidateId])
  @@index([recruiterId])
  @@index([status])
  @@index([deletedAt])
  @@index([offerCode])
  @@index([createdAt])
  @@index([updatedAt])
}

model CompanyOfferCounter {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count     Int     @default(0)
}

enum PipelineStage {
  APPLIED
  SCREENING
  SHORTLISTED
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER_PENDING
  OFFER_SENT
  OFFER_ACCEPTED
  HIRED
  REJECTED
  WITHDRAWN
}

model HiringPipeline {
  id              String             @id @default(uuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicationId   String             @unique
  application     Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId     String
  recruiter       User               @relation("PipelineRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  currentStage    PipelineStage      @default(APPLIED)
  previousStage   PipelineStage?
  stageChangedAt  DateTime           @default(now())
  stageOrder      Int                @default(1)
  notes           String?            @db.VarChar(2000)
  isCompleted     Boolean            @default(false)
  completedReason String?            // can be HIRED, REJECTED, WITHDRAWN
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  history         PipelineHistory[]
  timeline        PipelineTimeline[]

  @@index([companyId])
  @@index([applicationId])
  @@index([candidateId])
  @@index([recruiterId])
  @@index([jobId])
  @@index([currentStage])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model PipelineHistory {
  id             String         @id @default(uuid())
  pipelineId     String
  pipeline       HiringPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  fromStage      PipelineStage?
  toStage        PipelineStage
  movedById      String
  movedBy        User           @relation("PipelineHistoryMovedBy", fields: [movedById], references: [id], onDelete: Cascade)
  reason         String?        @db.VarChar(500)
  comments       String?        @db.VarChar(2000)
  movedAt        DateTime       @default(now())

  @@index([pipelineId])
  @@index([movedById])
}

enum PipelineTimelineEventType {
  APPLICATION_SUBMITTED
  CANDIDATE_SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_PENDING
  OFFER_SENT
  OFFER_ACCEPTED
  CANDIDATE_HIRED
  CANDIDATE_REJECTED
  CANDIDATE_WITHDRAWN
  RECRUITER_ADDED_NOTE
  STAGE_OVERRIDE
}

model PipelineTimeline {
  id          String                    @id @default(uuid())
  pipelineId  String
  pipeline    HiringPipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  eventType   PipelineTimelineEventType
  title       String                    @db.VarChar(255)
  description String                    @db.VarChar(2000)
  createdById String
  createdBy   User                      @relation("PipelineTimelineCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())

  @@index([pipelineId])
  @@index([createdById])
}

model ATSScore {
  id                   String    @id @default(cuid())
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                String
  job                  Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore         Int
  skillScore           Int
  experienceScore      Int
  educationScore       Int
  keywordScore         Int
  certificationScore   Int
  strengths            Json
  weaknesses           Json
  missingSkills        Json
  recommendations      Json
  hiringRecommendation String
  overallReason        String
  aiModel              String
  promptVersion        String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([candidateId])
  @@index([jobId])
}
