generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  RECRUITER
  CANDIDATE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String @id @default(cuid())

  email     String @unique
  password  String

  name      String?
  role      Role
  status    AccountStatus @default(ACTIVE)

  isVerified Boolean @default(false)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deletedAt  DateTime?

  // Auth additions
  mustChangePassword           Boolean   @default(false)
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  passwordResetToken           String?
  passwordResetExpiresAt       DateTime?
  emailVerificationToken       String?
  emailVerificationExpiresAt   DateTime?

  sessions                     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  website      String?
  industry     String?
  companySize  String?
  logoUrl      String?
  coverImage   String?
  email        String?
  phone        String?
  headquarters String?
  foundedYear  Int?
  linkedin     String?
  twitter      String?
  facebook     String?
  instagram    String?
  
  isVerified   Boolean       @default(false)
  status       AccountStatus @default(ACTIVE)

  deletedAt    DateTime?

  users        User[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}